# ---------- 数据集采集（ingestion/） ----------
# NCBI E-utilities API Key（可选；提供后限速从 3 req/s 提升至 10 req/s）
# 申请：https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# NCBI 要求的联系方式（建议填写真实邮箱，用于合规访问）
NCBI_EMAIL=openevidence-mvp@example.com

# ---------- 赛道3 实验/评测（core/llm.py） ----------
# 生成模型 / judge 共用的 OpenAI 兼容 API key（DeepSeek 等）
DEEPSEEK_API_KEY=sk-你的key

# 嵌入模型 API（config.yaml 里 embedding.backend=api；DashScope qwen3.7-text-embedding）
# EMBEDDING_API_KEY=sk-xxx
# DashScope（阿里云百炼）key：用于 qwen3.8-max judge 与嵌入
# DASHSCOPE_API_KEY=sk-xxx

# 可选：A2 通用搜索对照（config.yaml 里 a2.provider=serper）使用 Google Serper API
# 注册：https://serper.dev；不填则 A2 用离线 mock 演示
# SERPER_API_KEY=
