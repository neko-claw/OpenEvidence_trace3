{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "run.schema.json",
  "title": "Run",
  "description": "赛道3 单次实验运行记录（与实施规划 3.1 契约一致；B1 冻结）",
  "type": "object",
  "required": [
    "run_id", "question_id", "condition", "replicate", "model",
    "model_snapshot", "prompt_version", "config_hash", "dataset_version",
    "corpus_version", "index_version", "code_commit",
    "retrieved_evidence", "answer", "verification_decision",
    "latency_ms", "input_tokens", "output_tokens", "estimated_cost",
    "attempt_count", "status"
  ],
  "properties": {
    "run_id": { "type": "string", "description": "唯一运行 ID，包含题目、条件、配置、seed 和 replicate" },
    "question_id": { "type": "string" },
    "condition": { "type": "string", "enum": ["A", "A2", "B", "C", "D", "E"] },
    "replicate": { "type": "integer", "minimum": 1, "description": "REPEAT 子集重复序号；主跑为 1" },
    "seed": { "type": ["integer", "null"] },
    "model": { "type": "string" },
    "model_snapshot": { "type": "string", "description": "模型名+版本快照" },
    "prompt_version": { "type": "string" },
    "config_hash": { "type": "string", "description": "experiment_config.json 的 sha256" },
    "dataset_version": { "type": "string" },
    "corpus_version": { "type": "string" },
    "index_version": { "type": "string" },
    "code_commit": { "type": "string" },
    "provider_fingerprint": { "type": ["string", "null"] },
    "candidate_ids": { "type": "array", "items": { "type": "string" }, "description": "RRF 初检候选 ID 列表（B/C 同源）" },
    "agent_plan": { "type": ["array", "object", "null"], "description": "condition 说明或 D 条件 Agent 计划对象" },
    "tool_trace": { "type": ["array", "null"], "items": { "type": "object" }, "description": "仅 D 条件；工具名/输入/输出/耗时" },
    "retrieved_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "type": "object",
        "anyOf": [
          { "required": ["evidence_id"] },
          { "required": ["id"] }
        ],
        "properties": {
          "id": { "type": "string", "description": "证据稳定 ID（pmid/nct/guideline/epmc chunk）；A5 快照用" },
          "evidence_id": { "type": "string", "description": "证据稳定 ID；B4 运行器用" },
          "title": { "type": ["string", "null"] },
          "text": { "type": ["string", "null"] }
        }
      },
      "description": "实际进入上下文的证据记录（完整快照，供追溯与引用校验；B4 写 evidence_id，A5 写 id）"
    },
    "answer": { "type": ["string", "null"] },
    "claims": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "claim_id": { "type": "string" },
          "text": { "type": "string" },
          "criticality": { "type": "string", "enum": ["critical", "important", "context"] },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "decision": { "type": "string", "enum": ["supported", "contradicted", "insufficient", "pending", "SUPPORTED", "CONTRADICTED", "INSUFFICIENT"] }
        }
      }
    },
    "citations": {
      "type": ["array", "null"],
      "items": {
        "anyOf": [
          { "type": "string" },
          { "type": "object" }
        ]
      }
    },
    "verification_decision": {
      "type": "string",
      "enum": ["PASS", "WARN", "REFUSE"],
      "description": "支持性门禁输出"
    },
    "latency_ms": { "type": "integer" },
    "input_tokens": { "type": ["integer", "null"] },
    "output_tokens": { "type": ["integer", "null"] },
    "estimated_cost": { "type": ["number", "null"] },
    "d_extra_latency_ms": { "type": ["integer", "null"], "description": "D full-system overhead latency" },
    "d_extra_input_tokens": { "type": ["integer", "null"], "description": "D full-system overhead input tokens" },
    "d_extra_output_tokens": { "type": ["integer", "null"], "description": "D full-system overhead output tokens" },
    "d_extra_estimated_cost": { "type": ["number", "null"], "description": "D full-system overhead cost" },
    "cache_hits": { "type": ["integer", "null"] },
    "attempt_count": { "type": "integer", "description": "含重试次数" },
    "status": { "type": "string", "enum": ["pending", "running", "completed", "failed", "aborted", "ok", "error", "success", "not_applicable"], "description": "运行状态：编排生命周期用 pending/running/completed/failed/aborted；运行器实际写入 ok/error/success/not_applicable" },
    "error": { "type": ["string", "object", "null"] }
  }
}
